                <tr>
                    <td>102</td>
                    <td>Café Organico</td>
                    <td>Grano</td>
                    <td>18</td>
                    <td>2025-01-11</td>
                </tr>
                <tr>
                    <td>103</td>
                    <td>Cafe Premiun</td>
                    <td>Grano</td>
                    <td>30</td>
                    <td>2025-01-15</td>
