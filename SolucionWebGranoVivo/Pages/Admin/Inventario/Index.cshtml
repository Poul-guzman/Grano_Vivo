@page
@model SolucionWebGranoVivo.Pages.Admin.Inventario.IndexModel
@{
    ViewData["Title"] = "Inventario";
}

<h2>Inventario</h2>

@if (Model.Productos.Any())
{
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Código</th>
                <th>Stock</th>
                <th>Precio</th>
                <th>Origen</th>
                <th>Tipo Tueste</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Productos)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>@p.Codigo</td>
                    <td>@p.Stock</td>
                    <td>S/ @p.Precio</td>
                    <td>@p.Origen</td>
                    <td>@p.TipoTueste</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">No hay productos registrados en el inventario.</div>
}

<form method="post" class="mt-3">
    <button type="submit" class="btn btn-primary">Generar archivo CSV</button>
</form>

@if (Model.ArchivoGenerado != null)
{
    <div class="alert alert-success mt-3">
        Inventario generado: <strong>@Model.ArchivoGenerado</strong>
    </div>
}
