@page
@model SolucionWebGranoVivo.Pages.Admin.ReporteCompra.IndexModel
@{
    ViewData["Title"] = "Reporte de Compras";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Reporte de Compras</h2>

    <!-- Formulario de Filtros -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="GenerarReporte">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="ProveedorIdFiltro" class="form-label">Proveedor</label>
                            <select asp-for="ProveedorIdFiltro" asp-items="Model.Proveedores" class="form-select">
                                <option value="">Todos los proveedores</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" id="fechaInicio" class="form-control" 
                                   value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label for="fechaFin" class="form-label">Fecha Fin</label>
                            <input type="date" name="fechaFin" id="fechaFin" class="form-control" 
                                   value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Generar Reporte
                </button>
            </form>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <!-- Resumen de Totales -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">Totales por Proveedor</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var total in Model.TotalesPorProveedor)
                            {
                                var proveedorNombre = Model.Items.FirstOrDefault(i => i.ProveedorId == total.Key)?.ProveedorNombre ?? "N/A";
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@proveedorNombre</span>
                                    <strong>S/ @total.Value.ToString("F2")</strong>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">Costo Promedio por Producto</h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-group">
                            @foreach (var producto in Model.Items.GroupBy(i => i.ProductoNombre))
                            {
                                var promedio = producto.Average(i => i.PrecioUnitario);
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>@producto.Key</span>
                                    <strong>S/ @promedio.ToString("F2")</strong>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Resultados -->
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Detalle de Compras</h5>
                <div>
                    <a href="?handler=ExportarPdf&proveedorId=@Model.ProveedorIdFiltro&fechaInicio=@Model.FechaInicio?.ToString("yyyy-MM-dd")&fechaFin=@Model.FechaFin?.ToString("yyyy-MM-dd")" 
                       class="btn btn-danger btn-sm" target="_blank">
                        <i class="fas fa-file-pdf me-2"></i>Descargar PDF
                    </a>
                    <button onclick="window.print()" class="btn btn-secondary btn-sm ms-2">
                        <i class="fas fa-print me-2"></i>Imprimir
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario (S/)</th>
                                <th>Monto (S/)</th>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductoNombre</td>
                                    <td>@item.Cantidad</td>
                                    <td>S/ @item.PrecioUnitario.ToString("F2")</td>
                                    <td>S/ @item.Monto.ToString("F2")</td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@item.ProveedorNombre</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-info">
                            <tr>
                                <th colspan="3" class="text-end">Total General:</th>
                                <th colspan="3">S/ @Model.TotalGeneral.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No se encontraron compras con los filtros seleccionados.
        </div>
    }
</div>
