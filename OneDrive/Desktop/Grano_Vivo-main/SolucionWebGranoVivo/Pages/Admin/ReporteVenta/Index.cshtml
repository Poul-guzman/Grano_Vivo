@page
@model SolucionWebGranoVivo.Pages.Admin.ReporteVenta.IndexModel
@{
    ViewData["Title"] = "Reporte de Ventas";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">Reporte de Ventas</h2>

    <!-- Formulario de Filtros -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Filtros de Búsqueda</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="GenerarReporte">
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label asp-for="ClienteIdFiltro" class="form-label">Cliente</label>
                            <select asp-for="ClienteIdFiltro" asp-items="Model.Clientes" class="form-select">
                                <option value="">Todos los clientes</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                            <input type="date" name="fechaInicio" id="fechaInicio" class="form-control" 
                                   value="@(Model.FechaInicio?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="fechaFin" class="form-label">Fecha Fin</label>
                            <input type="date" name="fechaFin" id="fechaFin" class="form-control" 
                                   value="@(Model.FechaFin?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label for="estado" class="form-label">Estado</label>
                            <select name="estado" id="estado" asp-items="Model.Estados" class="form-select">
                            </select>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search me-2"></i>Generar Reporte
                </button>
            </form>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <!-- Resumen de Métricas -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h6 class="mb-0">Total General</h6>
                    </div>
                    <div class="card-body">
                        <h3 class="mb-0">S/ @Model.TotalGeneral.ToString("F2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">Ticket Promedio</h6>
                    </div>
                    <div class="card-body">
                        <h3 class="mb-0">S/ @Model.TicketPromedio.ToString("F2")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-warning text-white">
                        <h6 class="mb-0">Número de Operaciones</h6>
                    </div>
                    <div class="card-body">
                        <h3 class="mb-0">@Model.NumeroOperaciones</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla de Resultados -->
        <div class="card">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Detalle de Ventas</h5>
                <div>
                    <a href="?handler=ExportarPdf&clienteId=@Model.ClienteIdFiltro&fechaInicio=@Model.FechaInicio?.ToString("yyyy-MM-dd")&fechaFin=@Model.FechaFin?.ToString("yyyy-MM-dd")&estado=@Model.EstadoFiltro" 
                       class="btn btn-danger btn-sm" target="_blank">
                        <i class="fas fa-file-pdf me-2"></i>Descargar PDF
                    </a>
                    <button onclick="window.print()" class="btn btn-secondary btn-sm ms-2">
                        <i class="fas fa-print me-2"></i>Imprimir
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Cliente</th>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Monto (S/)</th>
                                <th>Fecha</th>
                                <th>Vendedor</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ClienteNombre</td>
                                    <td>@item.ProductoNombre</td>
                                    <td>@item.Cantidad</td>
                                    <td>S/ @item.Monto.ToString("F2")</td>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Vendedor</td>
                                    <td>
                                        <span class="badge bg-@(item.Estado == "Completado" ? "success" : item.Estado == "Cancelado" ? "danger" : "warning")">
                                            @item.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-info">
                            <tr>
                                <th colspan="3" class="text-end">Total General:</th>
                                <th colspan="4">S/ @Model.TotalGeneral.ToString("F2")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>No se encontraron ventas con los filtros seleccionados.
        </div>
    }
</div>